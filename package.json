{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build:css": "tailwindcss -i resources/css/app.css -o public/css/app.css --minify",
        "build:js": "esbuild resources/js/passkeys.js --bundle --minify --outfile=public/js/passkeys.js",
        "build": "npm run build:css && npm run build:js",
        "dev:css": "tailwindcss -i resources/css/app.css -o public/css/app.css --watch",
        "dev:js": "esbuild resources/js/passkeys.js --bundle --outfile=public/js/passkeys.js --watch",
        "dev": "concurrently \"npm run dev:css\" \"npm run dev:js\""
    },
    "dependencies": {
        "@laravel/passkeys": "^0.2.0",
        "@tailwindcss/cli": "^4.0.7",
        "concurrently": "^9.0.1",
        "esbuild": "^0.25.0",
        "tailwindcss": "^4.0.7"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
